# 複製這個檔案為 .env（跟這個檔案放在同一層的 config/ 目錄），並填入真實值。
# .env 不會被 git 追蹤（見 .gitignore），機密資訊不會進版控。

# LINE Messaging API（Channel access token，在 LINE Developers Console 的
# Messaging API 分頁取得，「Channel access token (long-lived)」那個按鈕產生）
LINE_CHANNEL_ACCESS_TOKEN=

# 要推播給誰：你自己的 LINE User ID（在 LINE Developers Console 的
# Messaging API 分頁，Bot info 底下可以看到，或是你的 Bot 加你好友後
# 用 webhook 印出 event.source.user_id 取得）
LINE_USER_ID=

# Streamlit Dashboard 的簡易密碼保護（部署到雲端、手機可連線時用，
# 純字串比對，不是完整帳號系統，只是避免網址外流被任何人看到你的資金部位）
DASHBOARD_PASSWORD=

# 排程自動通知（scheduler.py 的 job_notify）用來算建議倉位的總資金。
# 不設定的話，LINE 通知只會有訊號報告、不會有建議倉位（凱利公式需要一個實際金額才能算）。
TRADING_CAPITAL=
