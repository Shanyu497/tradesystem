# 本機開發不需要這個檔案（本機用 config/.env，見 config/.env.example）。
#
# 部署到 Streamlit Community Cloud 時，這個機制才會用到：
# 到你的 App -> Settings -> Secrets，把下面的內容（填入真實值後）貼上去，
# 雲端會在啟動時自動把這些值注入成 st.secrets["..."]，不需要、也不應該把
# 真正的 secrets.toml 傳到 git（見 .gitignore）。

LINE_CHANNEL_ACCESS_TOKEN = ""
LINE_USER_ID = ""
DASHBOARD_PASSWORD = ""
